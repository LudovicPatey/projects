Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forward the Authorization header to PHP (agent API tokens) — PHP-FPM drops it otherwise.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Serve existing static files directly (assets), everything else goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# app.html is only served through index.php
<Files "app.html">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Larger uploads (effective on OVH if php.ini overrides are allowed; see README)
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 80M
</IfModule>
